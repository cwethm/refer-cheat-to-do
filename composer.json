{
    "name": "cwethm/refer-cheat-to-do",
    "description": "API-first information continuity and ToDo foundation built with CakePHP 5.",
    "license": "MIT",
    "type": "project",
    "homepage": "https://github.com/cwethm/refer-cheat-to-do",
    "require": {
        "php": ">=8.3",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_pgsql": "*",
        "cakephp/cakephp": "5.4.*",
        "cakephp/migrations": "^5.0",
        "cakephp/plugin-installer": "^2.0"
    },
    "require-dev": {
        "cakephp/bake": "^3.6",
        "cakephp/cakephp-codesniffer": "^5.3",
        "cakephp/debug_kit": "^5.2",
        "josegonzalez/dotenv": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3 || ^12.1.3 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": true,
        "sort-packages": true,
        "use-github-api": false
    },
    "scripts": {
        "post-install-cmd": "App\\Console\\Installer::postInstall",
        "check": [
            "@lint",
            "@cs-check",
            "@stan",
            "@test"
        ],
        "lint": "find config src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cs-check": "phpcs --colors -p",
        "cs-fix": "phpcbf --colors -p",
        "stan": "phpstan analyse --memory-limit=512M",
        "test": "phpunit --colors=always"
    }
}
